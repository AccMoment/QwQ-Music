<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:panelVms="clr-namespace:QwQ_Music.ViewModels.Panels"
    xmlns:managers="clr-namespace:QwQ_Music.Common.Managers"
    xmlns:custom="clr-namespace:QwQ_Music.Views.UserControls"
    xmlns:behaviors="clr-namespace:QwQ_Music.UI.Behaviors"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:models="clr-namespace:QwQ_Music.Models"
    x:Class="QwQ_Music.Views.Panels.MusicListPanel"
    x:DataType="panelVms:MusicListPanelViewModel">
    <Panel>
        <StackPanel>
            <custom:MusicInfoHeader
                Cover="{Binding MusicListModel.CoverImage}"
                Title="{Binding MusicListModel.Name}"
                Description="{Binding MusicListModel.Description}"
                CreateTime="{Binding MusicListModel.CreateTime}"
                IsVisible="{Binding MusicListModel,Converter={x:Static ObjectConverters.IsNotNull}}" />

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">

                <StackPanel.Styles>
                    <Style Selector="u|IconButton">
                        <Setter Property="Theme" Value="{StaticResource BorderlessIconButton}" />
                    </Style>
                    <Style Selector="PathIcon">
                        <Setter Property="Margin" Value="5" />
                    </Style>
                </StackPanel.Styles>

                <TextBox CornerRadius="15"
                         HorizontalAlignment="Left"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="搜索音乐"
                         Width="200">
                    <TextBox.InnerLeftContent>
                        <PathIcon Data="{StaticResource SemiIconSearchStroked}" Height="14" Width="14" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <Button ToolTip.Tip="播放此歌单"
                        Classes="Icon"
                        CornerRadius="8"
                        Command="{Binding PlayMusicListCommand}"
                        IsEnabled="{Binding FilteredList.Count}"
                        Height="32" Width="32"
                        Padding="2">
                    <PathIcon Data="{StaticResource PlayIconData}" Margin="0" />
                </Button>

                <u:IconButton Icon="{StaticResource SemiIconMore}" ToolTip.Tip="更多">

                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="5">
                                <CheckBox Content="备注" Name="MoreColumn1" />
                                <CheckBox Content="大小" Name="MoreColumn2" />
                                <CheckBox Content="附注" Name="MoreColumn3" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>

                </u:IconButton>
            </StackPanel>

            <DataGrid Background="Transparent"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      SelectedItem="{Binding SelectedItems}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      ItemsSource="{Binding FilteredList}"
                      behaviors:ScrollToItemBehavior.ScrollToItem="{Binding $self.SelectedItem}">

                <DataGrid.Styles>

                    <Style Selector="DataGridRow">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>

                                    <MenuItem
                                        Command="{Binding SetMusicListCommand}"
                                        CommandParameter="{Binding $parent[DataGrid].ItemsSource}"
                                        Header="立即播放">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource SemiIconPlay}" Margin="2" />
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <MenuItem
                                        Header="添加到">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="{StaticResource SemiIconCopyAdd}"
                                                Margin="1.5" />
                                        </MenuItem.Icon>

                                        <MenuItem
                                            Header="已有歌单"
                                            IsVisible="{Binding (managers:MusicListsManager).Instance.MusicLists.Count}"
                                            ItemsSource="{Binding (managers:MusicListsManager).Instance.MusicLists}">

                                            <MenuItem.ItemContainerTheme>
                                                <ControlTheme TargetType="MenuItem"
                                                              x:DataType="models:MusicListModel"
                                                              BasedOn="{StaticResource BigIconMenuItem}">
                                                    <Setter Property="Header" Value="{Binding Name}" />
                                                    <Setter Property="Command"
                                                            Value="{Binding $parent[UserControl].((panelVms:MusicListPanelViewModel)DataContext).AddSelectedToCommand}" />
                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                    <Setter Property="Icon">
                                                        <Template>

                                                            <Border CornerRadius="5" ClipToBounds="True">
                                                                <Image
                                                                    Height="30" Width="30"
                                                                    Source="{Binding CoverImage}" />
                                                            </Border>
                                                        </Template>
                                                    </Setter>
                                                </ControlTheme>
                                            </MenuItem.ItemContainerTheme>

                                        </MenuItem>

                                        <Separator
                                            Margin="0,5"
                                            IsVisible="{Binding (managers:MusicListsManager).Instance.MusicLists.Count}" />

                                        <MenuItem Header="下一首"
                                                  Command="{Binding $parent[DataGrid].((panelVms:MusicListPanelViewModel)DataContext).AddToPlaylistNextCommand}"
                                                  CommandParameter="{Binding SelectedItems}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource SemiIconTriangleDown}"
                                                          Margin="2" />
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <!-- <MenuItem Header="新建歌单" -->
                                        <!--           Command="{Binding (managers:MusicListsManager).Instance.CreatePlaylistWithMusicItemCommand}" -->
                                        <!--           CommandParameter="{Binding SelectedItems}"> -->
                                        <!--     <MenuItem.Icon> -->
                                        <!--         <PathIcon Data="{StaticResource SemiIconMusic}" Margin="2" /> -->
                                        <!--     </MenuItem.Icon> -->
                                        <!-- </MenuItem> -->

                                    </MenuItem>

                                    <MenuItem
                                        Command="{Binding (managers:MusicItemsManager).All.ClearRecordsCommand}"
                                        CommandParameter="{Binding SelectedItems}"
                                        Header="清空播放时长">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource ClearEmpty}" Margin="2" />
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <MenuItem
                                        Command="{Binding RemoveSelectedFromCommand}"
                                        CommandParameter="{Binding MusicListModel}"
                                        IsVisible="{Binding MusicListModel,Converter={x:Static ObjectConverters.IsNotNull}}"
                                        Header="移出歌单">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource SemiIconForward}" Margin="2"
                                                      Foreground="{DynamicResource SemiRed4}"
                                                      RenderTransform="rotate(180deg)" />
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <MenuItem
                                        Command="{Binding (managers:MusicItemsManager).All.ShowDetailedInfoCommand}"
                                        CommandParameter="{Binding $parent[DataGrid].SelectedItem,Mode=OneWay}"
                                        Header="详细信息">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource SemiIconArticle}" Margin="2" />
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <!--  在文件中打开  -->
                                    <MenuItem
                                        Command="{Binding (managers:MusicItemsManager).All.OpenInExplorerCommand}"
                                        CommandParameter="{Binding $parent[DataGrid].SelectedItems[0],Mode=OneWay}"
                                        Header="在文件中打开">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource SemiIconFolder}" Margin="2" />
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <MenuItem
                                        Command="{Binding $parent[DataGrid].((panelVms:MusicListPanelViewModel)DataContext).RemoveSelectedFromCommand}"
                                        CommandParameter="{Binding SelectedItems}"
                                        Header="删除音乐"
                                        Background="{StaticResource SemiColorDanger}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource SemiIconDelete}" Margin="1"
                                                      Foreground="{DynamicResource SemiRed4}" />
                                        </MenuItem.Icon>
                                    </MenuItem>

                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style Selector="DataGridColumnHeadersPresenter> DataGridColumnHeader">
                        <Setter Property="Theme" Value="{StaticResource NoDecorativeThread}" />
                    </Style>

                    <Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
                        <Setter Property="Opacity" Value="0" />
                    </Style>

                    <Style Selector="DataGridRow:pointerover /template/ Border#BackgroundBorder">
                        <Setter Property="CornerRadius" Value="10" />
                    </Style>

                    <Style Selector="DataGridRow:selected /template/ Border#BackgroundBorder">
                        <Setter Property="CornerRadius" Value="10" />
                    </Style>

                    <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                        <Setter Property="Opacity" Value="0" />
                    </Style>

                    <Style Selector="DataGridCell:focus /template/ Panel#FocusVisual">
                        <Setter Property="Opacity" Value="0" />
                    </Style>

                </DataGrid.Styles>

                <DataGrid.Columns>

                    <DataGridTemplateColumn SortMemberPath="Title" Width="1*">

                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="歌曲" />
                                <TextBlock
                                    Classes="Tertiary"
                                    FontSize="12"
                                    Text=" / 演唱者"
                                    VerticalAlignment="Bottom" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">

                                    <custom:MusicAlbumCoverButton
                                        Command="{Binding (managers:AudioPlayManager).Instance.PlayThisMusicCommand}"
                                        CommandParameter="{Binding}"
                                        CornerRadius="8"
                                        ExternalPointerOver="{Binding $parent[DataGridRow].IsPointerOver}" />
                                    <!--<Button.Effect>
                                            <DropShadowEffect
                                                BlurRadius="10"
                                                Color="DarkGray"
                                                OffsetX="0"
                                                OffsetY="0"
                                                Opacity="0.5" />
                                        </Button.Effect>-->


                                    <StackPanel Spacing="5" VerticalAlignment="Center">
                                        <TextBlock FontWeight="Bold" Text="{Binding Title}" />
                                        <TextBlock
                                            Classes="Tertiary"
                                            FontSize="12"
                                            Text="{Binding Artists}" />
                                    </StackPanel>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Binding="{Binding Album}"
                        Header="专辑"
                        Width="1*" />

                    <DataGridTextColumn Header="备注"
                                        MinWidth="100"
                                        MaxWidth="200"
                                        IsVisible="{Binding ElementName=MoreColumn1,Path=IsChecked}"
                                        Binding="{Binding Comment}" />

                    <DataGridTemplateColumn Header="时长" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="5" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding Duration, Mode=OneWay, Converter={StaticResource TruncateDecimalConverter}}" />

                                    <TextBlock
                                        Classes="Tertiary"
                                        FontSize="12"
                                        Text="{Binding Record, Mode=OneWay, Converter={StaticResource TruncateDecimalConverter}, StringFormat='已播放到 : {0}'}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Binding="{Binding FileSize}"
                        Header="大小"
                        IsVisible="{Binding IsChecked, ElementName=MoreColumn2}"
                        MinWidth="100" />

                    <DataGridTextColumn
                        Binding="{Binding Remarks}"
                        Header="附注"
                        MaxWidth="200"
                        IsVisible="{Binding IsChecked, ElementName=MoreColumn3}"
                        MinWidth="100" />

                </DataGrid.Columns>

                <Interaction.Behaviors>

                    <DoubleTappedTrigger>
                        <InvokeCommandAction Command="{Binding SetMusicListCommand}"
                                             CommandParameter="{Binding MusicListModel}" />
                    </DoubleTappedTrigger>

                    <RoutedEventTriggerBehavior RoutedEvent="{x:Static DataGrid.SelectionChangedEvent}">
                        <InvokeCommandAction
                            Command="{Binding SelectedItemsChangedCommand}"
                            CommandParameter="{Binding $parent[DataGrid].SelectedItems}" />
                    </RoutedEventTriggerBehavior>

                    <behaviors:DataGridHorizontalScrollBehavior
                        HorizontalScrollValue="{Binding DataGridHorizontalScrollValue}" />

                </Interaction.Behaviors>

            </DataGrid>
        </StackPanel>

        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="10"
                    Margin="20">
            <Button Classes="FloatButton"
                    Command="{Binding ScrollToTopCommand}"
                    CommandParameter="{Binding $parent[DataGrid]}"
                    IsVisible="{Binding DataGridHorizontalScrollValue,Converter={StaticResource ValueComparisonConverter},ConverterParameter='@VALUE != 0'}"
                    ToolTip.Tip="跳转到顶部">
                <PathIcon Data="{StaticResource SemiIconAlignTop}" />
            </Button>
            <Button Classes="FloatButton"
                    IsVisible="{Binding FilteredList.Count}"
                    Command="{Binding SelectCurrentMusicItemCommand}"
                    ToolTip.Tip="跳转当前音乐">
                <PathIcon Data="{StaticResource SemiIconAlignCenterVertical}" />
            </Button>
        </StackPanel>
    </Panel>
</UserControl>