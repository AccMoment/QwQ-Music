<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:panelVms="clr-namespace:QwQ_Music.ViewModels.Panels"
    xmlns:managers="clr-namespace:QwQ_Music.Common.Managers"
    xmlns:customs="clr-namespace:QwQ_Music.Views.Customs"
    x:Class="QwQ_Music.Views.Pages.MusicListPage"
    x:DataType="panelVms:MusicListPanelViewModel">
    <StackPanel>
        <customs:MusicInfoHeader
            Cover="{Binding MusicListModel.Thumbnail,FallbackValue={Binding (managers:CacheManager).NotExist}}"
            Title="{Binding MusicListModel.Name}"
            Description="{Binding MusicListModel.Description}"
            CreateTime="{Binding MusicListModel.CreateTime}"
            IsVisible="{Binding MusicListModel,Converter={x:Static ObjectConverters.IsNotNull}}" />
        <customs:MusicListDataGrid DataContext="{Binding}" />
    </StackPanel>
</UserControl>