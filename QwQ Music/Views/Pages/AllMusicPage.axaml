<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages1="clr-namespace:QwQ_Music.ViewModels.Pages"
      xmlns:userControls="clr-namespace:QwQ_Music.Views.UserControls"
      xmlns:u="https://irihi.tech/ursa"
      xmlns:models="clr-namespace:QwQ_Music.Models"
      xmlns:behaviors="clr-namespace:QwQ_Music.UI.Behaviors"
      xmlns:vm="clr-namespace:QwQ_Music.ViewModels"
      mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
      x:DataType="pages1:AllMusicPageViewModel"
      RowDefinitions="Auto,*" Margin="0,5"
      x:Class="QwQ_Music.Views.Pages.AllMusicPage">

    <StackPanel HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">

        <StackPanel.Styles>

            <Style Selector="u|IconButton">
                <Setter Property="Theme" Value="{StaticResource BorderlessIconButton}" />
            </Style>

            <Style Selector="PathIcon">
                <Setter Property="Margin" Value="5" />
            </Style>

        </StackPanel.Styles>

        <TextBox CornerRadius="15"
                 HorizontalAlignment="Left"
                 Text="{Binding SearchText, Mode=TwoWay}"
                 Watermark="搜索音乐"
                 Width="200">
            <TextBox.InnerLeftContent>
                <PathIcon Data="{StaticResource SemiIconSearchStroked}" Height="14" Width="14" />
            </TextBox.InnerLeftContent>
        </TextBox>

        <u:IconButton ToolTip.Tip="添加音乐"
                      Icon="{StaticResource SemiIconPlus}">
            <u:IconButton.Flyout>
                <MenuFlyout>
                    <MenuItem Header="文件" Command="{Binding OpenFileCommand}" ToolTip.Tip="从文件添加音乐">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource SemiIconFile}" Margin="2" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="文件夹" Command="{Binding OpenFolderCommand}" ToolTip.Tip="从文件夹添加音乐">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource SemiIconFolderOpen}" Margin="2" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuFlyout>
            </u:IconButton.Flyout>
        </u:IconButton>

        <u:IconButton
            Command="{Binding RefreshMusicInfoCommand}"
            ToolTip.Tip="刷新音乐">
            <u:IconButton.Icon>
                <PathIcon Height="24" Width="24" Data="{StaticResource Refresh}" />
            </u:IconButton.Icon>
            <u:IconButton.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="强制刷新" Command="{Binding ForceRefreshMusicInfoCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource SemiIconRefresh}" Margin="2" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </u:IconButton.ContextMenu>
        </u:IconButton>

        <u:IconButton Icon="{StaticResource SemiIconMore}" ToolTip.Tip="更多">

            <Button.Flyout>
                <Flyout>
                    <StackPanel Spacing="5">
                        <CheckBox Content="备注" Name="MoreColumn1" />
                        <CheckBox Content="大小" Name="MoreColumn2" />
                        <CheckBox Content="附注" Name="MoreColumn3" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>

        </u:IconButton>

    </StackPanel>

    <DataGrid Background="Transparent"
              x:Name="AllMusicDataGrid"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              DragDrop.AllowDrop="True"
              Grid.Row="1"
              IsReadOnly="True"
              Margin="0,5"
              ItemsSource="{Binding MusicItems}"
              SelectedItem="{Binding SelectedItems}"
              SelectionMode="Extended"
              behaviors:ScrollToItemBehavior.ScrollToItem="{Binding SelectedItems}">

        <DataGrid.Styles>

            <Style Selector="DataGridRow">
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu>

                            <MenuItem
                                Command="{Binding SetMusicCommand}"
                                CommandParameter="{Binding MusicItems}"
                                Header="立即播放">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource SemiIconPlay}" Margin="2" />
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem
                                Header="添加到">
                                <MenuItem.Icon>
                                    <PathIcon
                                        Data="{StaticResource SemiIconCopyAdd}"
                                        Margin="1.5" />
                                </MenuItem.Icon>

                                <MenuItem
                                    Header="已有歌单"
                                    IsVisible="{Binding $parent[DataGrid].((pages1:AllMusicPageViewModel)DataContext).MusicListsManager.SongLists.Count}"
                                    ItemsSource="{Binding $parent[DataGrid].((pages1:AllMusicPageViewModel)DataContext).MusicListsManager.SongLists}">

                                    <MenuItem.ItemContainerTheme>
                                        <ControlTheme TargetType="MenuItem" x:DataType="models:MusicListModel"
                                                      BasedOn="{StaticResource BigIconMenuItem}">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="Command"
                                                    Value="{Binding $parent[DataGrid].((pages1:AllMusicPageViewModel)DataContext).AddSelectingToCommand}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                            <Setter Property="Icon">
                                                <Template>

                                                    <Border CornerRadius="5" ClipToBounds="True">
                                                        <Image
                                                            Height="30" Width="30"
                                                            Source="{Binding CoverImage}" />
                                                    </Border>

                                                </Template>
                                            </Setter>
                                        </ControlTheme>
                                    </MenuItem.ItemContainerTheme>

                                </MenuItem>

                                <Separator
                                    Margin="0,5"
                                    IsVisible="{Binding $parent[DataGrid].((pages1:AllMusicPageViewModel)DataContext).MusicListsManager.SongLists.Count}" />

                                <MenuItem Header="下一首"
                                          Command="{Binding $parent[DataGrid].((pages1:AllMusicPageViewModel)DataContext).AddToPlaylistNextCommand}"
                                          CommandParameter="{Binding $parent[DataGrid].SelectedItems}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource SemiIconTriangleDown}" Margin="2" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem Header="新建歌单"
                                          Command="{Binding $parent[DataGrid].((pages1:AllMusicPageViewModel)DataContext).MusicListsManager.CreatePlaylistWithMusicItemCommand}"
                                          CommandParameter="{Binding $parent[DataGrid].SelectedItems}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource SemiIconMusic}" Margin="2" />
                                    </MenuItem.Icon>
                                </MenuItem>

                            </MenuItem>

                            <MenuItem
                                Command="{Binding (vm:MusicPlayerViewModel).Current.ClearPlayDurationCommand}"
                                CommandParameter="{Binding $parent[DataGrid].SelectedItems}"
                                Header="清空播放时长">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource ClearEmpty}" Margin="2" />
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem
                                Command="{Binding $parent[DataGrid].((pages1:AllMusicPageViewModel)DataContext).MusicItemsManager.ShowDetailedInfoCommand}"
                                CommandParameter="{Binding $parent[DataGrid].SelectedItems[0],Mode=OneWay}"
                                Header="详细信息">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource SemiIconArticle}" Margin="2" />
                                </MenuItem.Icon>
                            </MenuItem>

                            <!--  在文件中打开  -->
                            <MenuItem
                                Command="{Binding $parent[DataGrid].((pages1:AllMusicPageViewModel)DataContext).MusicItemsManager.OpenInExplorerCommand}"
                                CommandParameter="{Binding $parent[DataGrid].SelectedItems,Mode=OneWay}"
                                Header="在文件中打开">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource SemiIconFolder}" Margin="2" />
                                </MenuItem.Icon>
                            </MenuItem>

                            <!--  删除  -->
                            <MenuItem
                                Command="{Binding $parent[DataGrid].((pages1:AllMusicPageViewModel)DataContext).DeleteMusicItemsCommand}"
                                CommandParameter="{Binding  $parent[DataGrid].SelectedItems}"
                                Header="删除音乐">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource SemiIconDelete}" Margin="1"
                                              Foreground="{DynamicResource SemiRed4}" />
                                </MenuItem.Icon>
                            </MenuItem>

                        </ContextMenu>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                <Style Selector="DataGrid /template/ DataGridColumnHeader#PART_TopLeftCornerHeader /template/ Border">
                    <Setter Property="Opacity" Value="0" />
                </Style>
                -->

            <Style Selector="DataGridColumnHeadersPresenter > DataGridColumnHeader">
                <Setter Property="Theme" Value="{StaticResource NoDecorativeThread}" />
            </Style>

            <!--
                <Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
                    <Setter Property="Opacity" Value="0" />
                </Style>
                -->

            <!--<Style Selector="DataGridRowHeader /template/ Grid">
                    <Setter Property="Opacity" Value="0" />
                </Style>-->

            <Style Selector="DataGridRow:pointerover /template/ Border#BackgroundBorder">
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style Selector="DataGridRow:selected /template/ Border#BackgroundBorder">
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                <Setter Property="Opacity" Value="0" />
            </Style>

            <Style Selector="DataGridCell:focus /template/ Panel#FocusVisual">
                <Setter Property="Opacity" Value="0" />
            </Style>

        </DataGrid.Styles>

        <DataGrid.Columns>

            <DataGridTemplateColumn SortMemberPath="Title" Width="1*">

                <DataGridTemplateColumn.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="歌曲" />
                        <TextBlock
                            Classes="Tertiary"
                            FontSize="12"
                            Text=" / 演唱者"
                            VerticalAlignment="Bottom" />
                    </StackPanel>
                </DataGridTemplateColumn.Header>

                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">

                            <userControls:MusicAlbumButton
                                Command="{Binding $parent[DataGrid].((pages1:AllMusicPageViewModel)DataContext).SetMusicCommand}"
                                CommandParameter="{Binding $parent[DataGrid].SelectedItems}"
                                CornerRadius="8"
                                CurrentMusicItem="{Binding (vm:MusicPlayerViewModel).Current.CurrentMusicItem.Model}"
                                ExternalMouseTouch="{Binding $parent[DataGridRow].IsPointerOver}"
                                IsPlaying="{Binding IsCurrent}">

                                <!--<Button.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Color="DarkGray"
                                        OffsetX="0"
                                        OffsetY="0"
                                        Opacity="0.5" />
                                </Button.Effect>-->

                            </userControls:MusicAlbumButton>

                            <DockPanel HorizontalSpacing="5" VerticalSpacing="5" VerticalAlignment="Center">
                                <TextBlock FontWeight="Bold" Text="{Binding Title}" DockPanel.Dock="Top" />
                                <Image DockPanel.Dock="Left"
                                       Height="12"
                                       IsVisible="{Binding $self.Source,Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Source="{Binding AudioQualityLevel,
                                            Converter={StaticResource AudioQualityLevelLogoConverter}}" />
                                <TextBlock DockPanel.Dock="Right"
                                           Classes="Tertiary"
                                           FontSize="12"
                                           Text="{Binding Artists}" />
                            </DockPanel>

                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>

            </DataGridTemplateColumn>

            <DataGridTextColumn
                Binding="{Binding Album}"
                Header="专辑"
                Width="1*" />

            <DataGridTextColumn Header="备注"
                                MinWidth="100"
                                MaxWidth="200"
                                IsVisible="{Binding ElementName=MoreColumn1,Path=IsChecked}"
                                Binding="{Binding Comment}" />

            <DataGridTemplateColumn Header="时长" MinWidth="120">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="5" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding Duration, Mode=OneWay, Converter={StaticResource TruncateDecimalConverter}}" />

                            <TextBlock
                                Classes="Tertiary"
                                FontSize="12"
                                Text="{Binding Record, Mode=OneWay, Converter={StaticResource TruncateDecimalConverter}, StringFormat='已播放到 : {0}'}" />
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn
                Binding="{Binding FileSize}"
                Header="大小"
                IsVisible="{Binding IsChecked, ElementName=MoreColumn2}"
                MinWidth="100" />

            <DataGridTextColumn
                Binding="{Binding Remarks}"
                Header="附注"
                MaxWidth="200"
                IsVisible="{Binding IsChecked, ElementName=MoreColumn3}"
                MinWidth="100" />

        </DataGrid.Columns>

        <Interaction.Behaviors>

            <DoubleTappedTrigger>
                <InvokeCommandAction Command="{Binding SetMusicCommand}" />
            </DoubleTappedTrigger>

            <RoutedEventTriggerBehavior RoutedEvent="{x:Static DataGrid.SelectionChangedEvent}">
                <InvokeCommandAction
                    Command="{Binding SelectingItemsChangedCommand}"
                    CommandParameter="{Binding $parent[DataGrid].SelectedItems}" />
            </RoutedEventTriggerBehavior>

            <behaviors:DataGridHorizontalScrollBehavior
                HorizontalScrollValue="{Binding DataGridHorizontalScrollValue}" />

        </Interaction.Behaviors>

    </DataGrid>

    <StackPanel Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Spacing="10"
                Margin="15,20">

        <Button Classes="FloatButton"
                Command="{Binding JumpToTopCommand}"
                CommandParameter="{Binding #AllMusicDataGrid}"
                IsVisible="{Binding DataGridHorizontalScrollValue,Converter={StaticResource ValueComparisonConverter},ConverterParameter='@VALUE != 0'}"
                ToolTip.Tip="跳转到顶部">
            <PathIcon Data="{StaticResource SemiIconAlignTop}" />
        </Button>

        <Button Classes="FloatButton"
                IsVisible="{Binding MusicItems.Count}"
                Command="{Binding SelectCurrentMusicItemCommand}"
                ToolTip.Tip="跳转当前音乐">
            <PathIcon Data="{StaticResource SemiIconAlignCenterVertical}" />
        </Button>

    </StackPanel>

    <Interaction.Behaviors>

        <RoutedEventTriggerBehavior RoutedEvent="{x:Static DragDrop.DropEvent}">
            <InvokeCommandAction Command="{Binding DropFilesCommand}" PassEventArgsToCommand="True" />
        </RoutedEventTriggerBehavior>

    </Interaction.Behaviors>

</Grid>