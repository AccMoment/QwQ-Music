<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:customs="clr-namespace:QwQ_Music.Views.Customs">
    <Style Selector="customs|MusicInfoHeader">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*" Height="150">
                    <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                            CornerRadius="12"
                            Margin="10"
                            Effect="{DynamicResource LightColor0DropShadowEffect}">
                        <Border CornerRadius="12"
                                ClipToBounds="True">
                            <Image
                                Source="{TemplateBinding Cover}" />
                        </Border>
                    </Border>
                    <SelectableTextBlock Grid.Row="0" Grid.Column="1"
                                         TextTrimming="CharacterEllipsis"
                                         FontWeight="Bold"
                                         VerticalAlignment="Bottom"
                                         FontSize="16"
                                         Text="{TemplateBinding Title}" />

                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{TemplateBinding Description}"
                             FontSize="12"
                             FontWeight="Normal"
                             MaxLines="5"
                             Margin="10"
                             TextWrapping="Wrap"
                             IsReadOnly="{TemplateBinding IsReadonly}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>