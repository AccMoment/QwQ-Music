<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <!--        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>-->
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
        <LangVersion>preview</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <ApplicationIcon>QwQ Music.ico</ApplicationIcon>
        <Version>2.1.0</Version>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
        <TrimMode>link</TrimMode>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
        <DefineConstants>_WIN_NT;$(DefineConstants)</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
        <DefineConstants>_LINUX;$(DefineConstants)</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
        <DefineConstants>_OSX;$(DefineConstants)</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>
    <ItemGroup>
        <None Include="QwQ Music.ico">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <AvaloniaResource Include="Assets\AvaloniaRes\**"/>
        <AvaloniaResource Remove="Assets\EmbeddedRes\**"/>
        <EmbeddedResource Include="Assets\EmbeddedRes\**"/>
        <None Update="i18n\zh_CN.QwQ.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.12"/>
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.12"/>
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.12"/>
        <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5"/>
        <PackageReference Include="Avalonia.Desktop" Version="11.3.12"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12"/>
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="AvaloniaUI.DiagnosticsSupport" Version="2.1.1">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
        <PackageReference Include="Irihi.Ursa" Version="1.15.0"/>
        <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="1.15.0"/>
        <PackageReference Include="managed-midi" Version="1.10.1"/>
        <PackageReference Include="QwQ.Avalonia.Control" Version="0.1.7.3"/>
        <PackageReference Include="Semi.Avalonia" Version="11.3.7.3"/>
        <PackageReference Include="Semi.Avalonia.ColorPicker" Version="11.3.7.3"/>
        <PackageReference Include="Semi.Avalonia.DataGrid" Version="11.3.7.3"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3"/>
        <PackageReference Include="SkiaSharp" Version="3.119.2"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2"/>
        <PackageReference Include="SoundFlow" Version="1.4.0"/>
        <PackageReference Include="Tmds.DBus" Version="0.94.0"/>
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.0"/>
        <PackageReference Include="Xaml.Behaviors.Avalonia" Version="11.3.9.5"/>
        <PackageReference Include="z440.atl.core" Version="7.11.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Impressionist\Impressionist.csproj"/>
        <ProjectReference Include="..\NcmdumpCSharp\NcmdumpCSharp\NcmdumpCSharp.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\LICENSE.md" Pack="true" PackagePath="\">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>

    </ItemGroup>
</Project>
